{
  "$schema": "shadetube-theme/1",
  "name": "Sepya",
  "base": "dark",
  "note": "Warm brown paper-dark: parchment text, amber accent.",
  "keys": {
    "background": "#1C1712",
    "surface": "#241E17",
    "text": "#EEE2CC",
    "outline": "#EEE2CC",
    "accent": "#E3A857"
  },
  "color": {
    "bg": {
      "base": "#1C1712",
      "raised": "#241E17",
      "overlay": "#2E261D",
      "sunken": "#15110D",
      "elevated": "#382F24"
    },
    "fg": {
      "primary": "#EEE2CC",
      "secondary": "#BBAA8E",
      "tertiary": "#8A7A62",
      "disabled": "#5F5444",
      "inverse": "#1C1712"
    },
    "hairline": {
      "subtle": "rgba(238,226,204,0.07)",
      "default": "rgba(238,226,204,0.11)",
      "strong": "rgba(238,226,204,0.17)",
      "control": "rgba(238,226,204,0.22)"
    },
    "overlay": {
      "hover": "rgba(238,226,204,0.05)",
      "pressed": "rgba(238,226,204,0.09)",
      "selected": "rgba(238,226,204,0.06)",
      "scrim": "rgba(28,23,18,0.6)",
      "scrimHeavy": "rgba(28,23,18,0.85)"
    },
    "accent": {
      "base": "#E3A857"
    },
    "status": {
      "error": "#EC7B5F",
      "warning": "#E8BC5A",
      "success": "#A9C98A",
      "info": "#92BFD0",
      "youtube": "#F06A55"
    },
    "skeleton": {
      "base": "rgba(238,226,204,0.06)",
      "shine": "rgba(238,226,204,0.12)"
    },
    "chrome": {
      "captionHover": "rgba(238,226,204,0.08)",
      "closeHover": "#C42B1C",
      "closeHoverFg": "#FFFFFF"
    }
  },
  "effects": {
    "cardHoverShadow": {
      "color": "#000000",
      "opacity": 0.45
    },
    "menuShadow": {
      "color": "#000000",
      "opacity": 0.55
    },
    "dialogShadow": {
      "color": "#000000",
      "opacity": 0.6
    },
    "toastShadow": {
      "color": "#000000",
      "opacity": 0.5
    },
    "nowPlayingArtShadow": {
      "color": "#000000",
      "opacity": 0.5
    }
  }
}
