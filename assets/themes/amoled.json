{
  "$schema": "shadetube-theme/1",
  "name": "AMOLED",
  "base": "dark",
  "note": "True black for OLED screens: surfaces only a few steps above #000, hairlines a little stronger.",
  "keys": {
    "background": "#000000",
    "surface": "#0B0B0B",
    "text": "#F4F4F4",
    "outline": "#F4F4F4",
    "accent": "#DDFF47"
  },
  "color": {
    "bg": {
      "base": "#000000",
      "raised": "#0B0B0B",
      "overlay": "#161616",
      "sunken": "#000000",
      "elevated": "#1E1E1E"
    },
    "fg": {
      "primary": "#F4F4F4",
      "secondary": "#A8A8A8",
      "tertiary": "#767676",
      "disabled": "#4A4A4A",
      "inverse": "#000000"
    },
    "hairline": {
      "subtle": "rgba(244,244,244,0.07)",
      "default": "rgba(244,244,244,0.11)",
      "strong": "rgba(244,244,244,0.17)",
      "control": "rgba(244,244,244,0.22)"
    },
    "overlay": {
      "hover": "rgba(244,244,244,0.06)",
      "pressed": "rgba(244,244,244,0.1)",
      "selected": "rgba(244,244,244,0.07)",
      "scrim": "rgba(0,0,0,0.6)",
      "scrimHeavy": "rgba(0,0,0,0.85)"
    },
    "accent": {
      "base": "#DDFF47"
    },
    "status": {
      "error": "#FF5C5C",
      "warning": "#FFB547",
      "success": "#7CE0A6",
      "info": "#7CE0FF",
      "youtube": "#FF3D3D"
    },
    "skeleton": {
      "base": "rgba(244,244,244,0.07)",
      "shine": "rgba(244,244,244,0.13)"
    },
    "chrome": {
      "captionHover": "rgba(244,244,244,0.09)",
      "closeHover": "#C42B1C",
      "closeHoverFg": "#FFFFFF"
    }
  },
  "effects": {
    "cardHoverShadow": {
      "color": "#000000",
      "opacity": 0.6
    },
    "menuShadow": {
      "color": "#000000",
      "opacity": 0.7
    },
    "dialogShadow": {
      "color": "#000000",
      "opacity": 0.75
    },
    "toastShadow": {
      "color": "#000000",
      "opacity": 0.65
    },
    "nowPlayingArtShadow": {
      "color": "#000000",
      "opacity": 0.6
    }
  }
}
