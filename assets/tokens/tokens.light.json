{
  "$schema": "shadetube-tokens/1",
  "theme": "light",
  "color": {
    "bg": {
      "base": "#F4EFE6",
      "raised": "#FBF8F2",
      "overlay": "#FFFFFF",
      "sunken": "#EAE4D9",
      "elevated": "#FFFFFF"
    },
    "fg": {
      "primary": "#14110E",
      "secondary": "#5E574F",
      "tertiary": "#8E867B",
      "disabled": "#B8B0A5",
      "inverse": "#F3EDE4"
    },
    "hairline": {
      "subtle": "rgba(20,17,14,0.06)",
      "default": "rgba(20,17,14,0.10)",
      "strong": "rgba(20,17,14,0.16)",
      "control": "rgba(20,17,14,0.22)"
    },
    "overlay": {
      "hover": "rgba(20,17,14,0.05)",
      "pressed": "rgba(20,17,14,0.09)",
      "selected": "rgba(20,17,14,0.06)",
      "scrim": "rgba(244,239,230,0.55)",
      "scrimHeavy": "rgba(244,239,230,0.85)"
    },
    "accent": {
      "name": "Volt light",
      "base": "#AED600",
      "onAccent": "#0F0D0B",
      "hover": "#C7F500",
      "pressed": "#8DAD00",
      "muted": "#2D3508",
      "subtle": "#0F1103",
      "glowRgba": "rgba(174,214,0,0.18)",
      "tint06": "rgba(174,214,0,0.06)",
      "tint12": "rgba(174,214,0,0.12)",
      "tint25": "rgba(174,214,0,0.25)",
      "bufferedRgba": "rgba(174,214,0,0.25)",
      "headerWash": "rgba(174,214,0,0.10)",
      "note": "Light theme darkens the extracted accent until contrast vs bg.base ≥ 3:1 (L* clamp ≤ 62)."
    },
    "status": {
      "error": "#C8321F",
      "warning": "#B5730A",
      "success": "#1E8A55",
      "info": "#0A7AA6",
      "offline": "#5E574F",
      "youtube": "#D92626",
      "spotify": "#169C46"
    },
    "skeleton": {
      "base": "rgba(20,17,14,0.06)",
      "shine": "rgba(20,17,14,0.12)"
    },
    "chrome": {
      "captionHover": "rgba(20,17,14,0.08)",
      "closeHover": "#C42B1C",
      "closeHoverFg": "#FFFFFF"
    }
  },
  "typography": {
    "families": {
      "display": "Bricolage Grotesque",
      "ui": "Bricolage Grotesque",
      "mono": "JetBrains Mono"
    },
    "scale": {
      "hero": {
        "size": 96,
        "weight": 800,
        "lineHeight": 0.92,
        "tracking": -0.045,
        "opsz": 96
      },
      "displayXL": {
        "size": 88,
        "weight": 800,
        "lineHeight": 0.9,
        "tracking": -0.05,
        "opsz": 96
      },
      "displayL": {
        "size": 64,
        "weight": 800,
        "lineHeight": 1,
        "tracking": -0.04,
        "opsz": 96
      },
      "displayM": {
        "size": 56,
        "weight": 800,
        "lineHeight": 1,
        "tracking": -0.04,
        "opsz": 96
      },
      "displayS": {
        "size": 36,
        "weight": 800,
        "lineHeight": 1,
        "tracking": -0.04
      },
      "headline": {
        "size": 28,
        "weight": 300,
        "lineHeight": 1.1,
        "tracking": -0.02
      },
      "title": {
        "size": 22,
        "weight": 700,
        "lineHeight": 1.2,
        "tracking": -0.02
      },
      "sectionTitle": {
        "size": 18,
        "weight": 700,
        "lineHeight": 1.2,
        "tracking": -0.02
      },
      "bodyL": {
        "size": 15,
        "weight": 400,
        "lineHeight": 1.5,
        "tracking": 0
      },
      "body": {
        "size": 14,
        "weight": 600,
        "lineHeight": 1.3,
        "tracking": 0
      },
      "bodyRegular": {
        "size": 14,
        "weight": 400,
        "lineHeight": 1.3,
        "tracking": 0
      },
      "secondary": {
        "size": 13,
        "weight": 400,
        "lineHeight": 1.3,
        "tracking": 0
      },
      "caption": {
        "size": 12,
        "weight": 400,
        "lineHeight": 1.3,
        "tracking": 0
      },
      "small": {
        "size": 11,
        "weight": 400,
        "lineHeight": 1.3,
        "tracking": 0
      },
      "monoLabel": {
        "family": "mono",
        "size": 10,
        "weight": 500,
        "lineHeight": 1.3,
        "tracking": 0.14,
        "uppercase": true
      },
      "monoMeta": {
        "family": "mono",
        "size": 11,
        "weight": 400,
        "lineHeight": 1.3,
        "tracking": 0.06
      },
      "monoDuration": {
        "family": "mono",
        "size": 12,
        "weight": 400,
        "lineHeight": 1,
        "tracking": 0.04,
        "tabular": true
      },
      "monoBadge": {
        "family": "mono",
        "size": 9,
        "weight": 700,
        "lineHeight": 1,
        "tracking": 0.1,
        "uppercase": true
      },
      "lyricActive": {
        "size": 44,
        "weight": 800,
        "lineHeight": 1.15,
        "tracking": -0.03
      },
      "lyricInactive": {
        "size": 28,
        "weight": 500,
        "lineHeight": 1.15,
        "tracking": -0.03
      }
    },
    "trackingUnit": "em",
    "note": "tracking values are em multipliers (e.g. -0.04 → -0.04em = -4% of font size). DirectWrite: use IDWriteTextLayout1::SetCharacterSpacing with leading/trailing = tracking*fontSize/2."
  },
  "spacing": {
    "unit": 4,
    "s0": 0,
    "s1": 4,
    "s2": 8,
    "s3": 12,
    "s4": 16,
    "s5": 20,
    "s6": 24,
    "s7": 28,
