  "opacity": {
    "disabled": 0.38,
    "hoverOverlay": 0.05,
    "pressedOverlay": 0.09,
    "selectedOverlay": 0.08,
    "dimPast": 0.35,
    "dimFuture": 0.22,
    "backdropScrim": 0.55,
    "skeletonBase": 0.06,
    "skeletonShine": 0.12,
    "scrollbarIdle": 0,
    "scrollbarVisible": 0.25,
    "scrollbarHover": 0.45
  },
  "effects": {
    "note": "Render with Direct2D effects (Gaussian blur / shadow). Nothing is baked into assets.",
    "nowPlayingGlow": {
      "type": "glow",
      "blurRadius": 120,
      "offsetX": 0,
      "offsetY": 0,
      "color": "accent.base",
      "opacity": 0.22
    },
    "nowPlayingArtShadow": {
      "type": "shadow",
      "blurRadius": 60,
      "offsetX": 0,
      "offsetY": 30,
      "color": "#000000",
      "opacity": 0.5
    },
    "playerThumbGlow": {
      "type": "glow",
      "blurRadius": 40,
      "offsetX": 0,
      "offsetY": 0,
      "color": "accent.base",
      "opacity": 0.18
    },
    "cardHoverShadow": {
      "type": "shadow",
      "blurRadius": 24,
      "offsetX": 0,
      "offsetY": 12,
      "color": "#14110E",
      "opacity": 0.14
    },
    "menuShadow": {
      "type": "shadow",
      "blurRadius": 32,
      "offsetX": 0,
      "offsetY": 16,
      "color": "#14110E",
      "opacity": 0.18
    },
    "dialogShadow": {
      "type": "shadow",
      "blurRadius": 64,
      "offsetX": 0,
      "offsetY": 32,
      "color": "#14110E",
      "opacity": 0.22
    },
    "toastShadow": {
      "type": "shadow",
      "blurRadius": 24,
      "offsetX": 0,
      "offsetY": 8,
      "color": "#14110E",
      "opacity": 0.16
    },
    "backdropBlur": {
      "type": "gaussianBlur",
      "blurRadius": 40,
      "scale": 1.15,
      "scrimColor": "bg.base",
      "scrimOpacity": 0.55,
      "saturation": 1.1
    },
    "miniPlayerBackdropBlur": {
      "type": "gaussianBlur",
      "blurRadius": 24,
      "scale": 1.2,
      "scrimOpacity": 0.6
    },
    "noise": {
      "texture": "textures/noise-tile.png",
      "tile": 256,
      "blend": "overlay",
      "opacity": 0.04
    },
    "headerWash": {
      "type": "linearGradient",
      "angle": 180,
      "from": "accent.headerWash",
      "to": "transparent",
      "height": 420
    }
  },
  "motion": {
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "linear": "cubic-bezier(0, 0, 1, 1)"
    },
    "duration": {
      "instant": 0,
      "fast": 120,
      "normal": 180,
      "medium": 240,
      "slow": 320,
      "page": 360,
      "lyrics": 420,
      "equalizerFrame": 66,
      "skeletonCycle": 1400,
      "accentCrossfade": 600,
      "toast": 4000
    }
  }
}