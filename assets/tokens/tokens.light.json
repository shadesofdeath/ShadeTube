  "radius": {
    "surface": 2,
    "control": 999,
    "circle": 9999,
    "badge": 2,
    "tooltip": 2,
    "menu": 2,
    "dialog": 2,
    "toast": 2,
    "scrollbarThumb": 1,
    "none": 0
